# Claude (https://platform.claude.com) — the tutor is Sonnet 5; new tutor sketches are drawn with Opus 5
ANTHROPIC_API_KEY=

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Deepgram (https://console.deepgram.com) — speech-to-text and text-to-speech
DEEPGRAM_API_KEY=
# British voices: aura-2-pandora-en (female) or aura-2-draco-en (male)
DEEPGRAM_VOICE=aura-2-pandora-en

# "simulated" grants top-ups without charging a card, until Stripe is connected.
PAYMENTS_MODE=simulated

# Pessimistic exchange rate used to convert provider costs into credits (1 credit = 1p).
USD_TO_GBP=0.80
